// StirHex resource script (top level).
// Strategy: this file supplies the binary asset statements (icons, bitmaps,
// cursors) that reference the files extracted under res\, then pulls in the
// faithfully-extracted logical resources (menus / dialogs / accelerators /
// string table) from res\StirHex.rc. Keeping res\StirHex.rc as the single
// source of the extracted data avoids duplicating ~1700 lines here.
#include "resource.h"
#include <afxres.h>

#pragma code_page(65001)

/////////////////////////////////////////////////////////////////////////////
// Original StirHex icons (generated by porting/tools/generate_icons.py)
IDR_MAINFRAME    ICON    "res\\ico_128.ico"
IDR_STIRLINGTYPE ICON    "res\\ico_129.ico"

/////////////////////////////////////////////////////////////////////////////
// Original StirHex toolbar bitmap (generated by porting/tools/generate_toolbar.py)
128 BITMAP "res\\bmp_128.bmp"

/////////////////////////////////////////////////////////////////////////////
// Logical resources: menus, dialogs, accelerators, string table.
// (numeric IDs preserved verbatim from the original; see resource.h for the
//  symbolic names used on the C++ side.)
#include "res\\StirHex.rc"

/////////////////////////////////////////////////////////////////////////////
// StirHex file and product metadata. This block is deliberately kept in this
// top-level file so regenerating res\StirHex.rc from the original executable
// cannot remove it.
VS_VERSION_INFO VERSIONINFO
  FILEVERSION     1,0,0,0
  PRODUCTVERSION  1,0,0,0
  FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
  FILEFLAGS       VS_FF_DEBUG
#else
  FILEFLAGS       0x0L
#endif
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041104B0"
    BEGIN
      VALUE "CompanyName",      "StirHex Project"
      VALUE "FileDescription",  "StirHex バイナリエディタ"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "StirHex"
      VALUE "OriginalFilename", "StirHex.exe"
      VALUE "ProductName",      "StirHex"
      VALUE "ProductVersion",   "1.0.0.0"
      VALUE "LegalCopyright",   "Copyright (C) 2026 StirHex Project"
      VALUE "Comments",         "Based on BinaryEditor Stirling Version 1.31 (Copyright (C) 1998-1999 ＤＤＳ２). 非公式の再実装版であり、原作者とは無関係です。"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x411, 1200
  END
END
